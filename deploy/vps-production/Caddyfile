{
    log {
        output discard
    }
}

:80 {
    root * /srv
    encode zstd gzip
    header {
        Cache-Control "no-cache"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    handle /api/research/* {
        reverse_proxy rd-cafe-research:8091
    }
    handle {
        try_files {path} /index.html
        file_server
    }
}
